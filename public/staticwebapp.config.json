{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/mock-assets/*", "*.{css,js,json,png,jpg,jpeg,svg,ico,woff,woff2}"]
  },
  "globalHeaders": {
    "cache-control": "no-cache"
  },
  "routes": [
    {
      "route": "/assets/*",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    }
  ]
}
