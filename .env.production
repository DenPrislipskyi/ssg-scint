# Read by Vite when it builds for production, which `vite build` does by
# default. Committed on purpose: `.env` is gitignored and never reaches the
# deploy runner, so without this the bundle falls back to `mock` - which is
# what the deployed site had been serving since the first deploy.
#
# Nothing secret belongs here. Vite inlines every VITE_* value into the bundle,
# so anything written here is readable by anyone who opens the page.

# `hybrid`, not `http`: the agent serves the RFQ list and the matching screen
# and nothing else yet. `http` would point the catalogue and supplier screens
# at endpoints that do not exist.
VITE_API_MODE=hybrid

# The deployed agent. A relative `/api/v1` works in development because the
# Vite dev server proxies it; in production it would mean the static host,
# which has no API behind it.
VITE_API_BASE_URL=https://rfq-agent-container.niceriver-2680c12c.eastus.azurecontainerapps.io/api/v1
